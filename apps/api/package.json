{
  "name": "@g-scores/api",
  "version": "0.1.0",
  "private": true,
  "description": "G-Scores NestJS modular monolith",
  "type": "commonjs",
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "dev:build": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "node --env-file-if-exists=.env --watch --watch-preserve-output dist/main.js",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "check": "npm run db:generate && tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/serve-static": "5.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
