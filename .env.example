APP_PORT=3000
PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=g_scores
POSTGRES_USER=g_scores
# shortcut: use a URL-safe password; encode credentials when arbitrary password characters are required.
POSTGRES_PASSWORD=change_this_local_password
# Keep this URL in sync with the PostgreSQL credentials and host port above.
DATABASE_URL=postgresql://g_scores:change_this_local_password@127.0.0.1:5432/g_scores?schema=public
