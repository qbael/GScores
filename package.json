{
  "name": "g-scores",
  "version": "0.1.0",
  "private": true,
  "description": "G-Scores TypeScript monolith bootstrap",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run build --workspace=@g-scores/api",
    "dev": "node scripts/dev.mjs",
    "test:dev": "node --test scripts/dev.test.mjs",
    "db:generate": "npm run db:generate --workspace=@g-scores/api",
    "db:migrate": "npm run db:migrate --workspace=@g-scores/api",
    "check": "npm run check --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test:dev",
    "start": "npm run start --workspace=@g-scores/api"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
